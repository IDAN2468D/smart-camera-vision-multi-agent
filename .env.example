# ===============================================================
# Smart Camera Vision Multi-Agent System - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# ===============================================================

# 🔑 Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 🗄️ MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.purdk.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vision_agents_db
COLLECTION_NAME=detections

# 🤖 Active Vision-Language Foundation Model
MODEL_ID=gemini-3.5-flash-lite

# 🧠 Visual RAG Embeddings (Atlas Vector Search)
# NOTE: changing EMBEDDING_MODEL or EMBEDDING_DIM requires re-embedding (POST /backfill) and a new vector index
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
VECTOR_INDEX_NAME=vector_index
SIMILARITY_THRESHOLD=0.8

# 🌐 Microservices Host Ports Mapping
PORT_FRONTEND=3002
PORT_BACKEND=5005
PORT_MCP=5006
PORT_VOICE=5007
PORT_EMBEDDING=5008

# ⚙️ Runtime Settings
HEADLESS=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
